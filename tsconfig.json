{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": false,
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "include": ["frontend/js/**/*.js"],
  "exclude": ["frontend/vendor/**"]
}
